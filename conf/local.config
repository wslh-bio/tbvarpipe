ts = new Date().format('yyyy.MM.dd-HH.mm.ss')
workDir = "work/${ts}"
params {
  static_assets = "s3://dev-wslh-healthomics-cdd-genomics-databases/mtb/amd-ph-core-static-assets/"
  outdir = "results/${ts}"
}
aws {
  client {
    anonymous = false
  }
}
process {
    withName: CLOCKWORK_MINIMAP2 {
        cpus = 6
        memory = {28.GB * task.attempt  }
        time = 8.h
    }
}
